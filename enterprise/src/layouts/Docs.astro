---
import Base from './Base.astro';
import Rail from '../components/Rail.astro';
import { BASE, DOCS_SOURCE, NAV, docsHref, flatNav } from '../lib/nav';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  frontmatter: { title: string; description?: string; lead?: string };
  headings?: Heading[];
  file?: string;
}

const { frontmatter, headings = [], file = '' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const pages = flatNav();
const index = pages.findIndex((p) => docsHref(p.href) === path);
const page = pages[index];
const prev = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const isApi = path.startsWith(`${BASE}docs/api/`);
const source = file ? `${DOCS_SOURCE}/${file.slice(file.indexOf('src/pages/'))}` : DOCS_SOURCE;
const method = /^((?:GET|POST|PUT|PATCH|DELETE)(?:\/(?:GET|POST|PUT|PATCH|DELETE))*)\s*(\S+)$/;
---

<Base title={`${frontmatter.title} - Happy Enterprise docs`} description={frontmatter.description ?? frontmatter.lead}>
  <div class="frame">
    <Rail current={isApi ? 'api' : 'docs'} path={path} />
    <div class="page-body">
      <details class="docs-nav docs-nav--mobile">
        <summary>Documentation</summary>
        <nav aria-label="Documentation">
          <ul class="docs-nav__list">
            {
              NAV.map((g) => (
                <li>
                  <span class="docs-nav__group">{g.group}</span>
                  <ul class="docs-nav__list">
                    {g.items.map((i) => (
                      <li>
                        <a href={docsHref(i.href)} aria-current={docsHref(i.href) === path ? 'page' : undefined}>
                          {i.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
      <div class="doc-grid">
        <main class="doc-main" id="content">
          {page && <nav aria-label="Breadcrumb" class="breadcrumb">{page.group}</nav>}
          {
            toc.length > 0 && (
              <details class="toc-mobile">
                <summary>On this page</summary>
                <ul>
                  {toc.map((h) => (
                    <li data-depth={h.depth}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </details>
            )
          }
          <article class="prose">
            <h1>{frontmatter.title}</h1>
            {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
            <slot />
          </article>
          {
            (prev || next) && (
              <nav class="pager" aria-label="Previous and next pages">
                {prev && (
                  <a href={docsHref(prev.href)} class="prev">
                    <small>← Previous</small>
                    <span>{prev.title}</span>
                  </a>
                )}
                {next && (
                  <a href={docsHref(next.href)} class="next">
                    <small>Next →</small>
                    <span>{next.title}</span>
                  </a>
                )}
              </nav>
            )
          }
        </main>
        <aside class="toc" aria-label="On this page">
          {
            toc.length > 0 && (
              <>
                <p class="toc__title">On this page</p>
                <ul data-spy="location">
                  {toc.map((h) => {
                    const m = h.text.match(method);
                    return (
                      <li data-depth={h.depth}>
                        <a href={`#${h.slug}`}>
                          {m ? (
                            <>
                              {m[1].split('/').map((x) => (
                                <span class={`ep-method ep-${x.toLowerCase()}`}>{x}</span>
                              ))}
                              {m[2]}
                            </>
                          ) : (
                            h.text
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </>
            )
          }
          <div class="toc__actions">
            <button type="button" data-scroll-top>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
              Scroll to top
            </button>
            <a href={source}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
              Edit this page
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Base>
