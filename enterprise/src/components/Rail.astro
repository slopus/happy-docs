---
import Mark from './Mark.astro';
import { BASE, NAV, docsHref } from '../lib/nav';

interface Props {
  /** Which main link is current. */
  current: 'home' | 'docs' | 'api';
  /** Landing page: numbered section links. */
  sections?: { id: string; title: string }[];
  /** Docs pages: the current page's path, to mark it in the sidebar. */
  path?: string;
}

const { current, sections, path } = Astro.props;
const docs = path !== undefined;
const normalize = (p: string) => (p.endsWith('/') ? p : p + '/');
const here = path ? normalize(path) : '';
---

<aside class="rail">
  <a href={BASE} class="rail__brand" aria-label="Happy Enterprise home">
    <Mark />
    <span class="rail__brand-name">Happy Enterprise</span>
  </a>
  <div class="rail__stack">
    <nav class="rail__nav" aria-label="Main">
      <a href={BASE} class="rail__link rail__link--keep" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
      <a href={docsHref('')} class="rail__link rail__link--keep" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
      <a href={docsHref('api/')} class="rail__link" aria-current={current === 'api' ? 'page' : undefined}>API</a>
      <a href={docsHref('how-it-fits/')} class="rail__link">How it fits</a>
    </nav>

    {
      docs && (
        <div class="docs-rail__secondary">
          <button type="button" class="search-open" data-search-open aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <span>Search</span>
            <kbd data-kbd>Ctrl K</kbd>
          </button>
          <nav aria-label="Documentation" class="docs-nav docs-nav--desktop">
            <ul class="docs-nav__list">
              {NAV.map((g) => (
                <li>
                  <span class="docs-nav__group">{g.group}</span>
                  <ul class="docs-nav__list">
                    {g.items.map((i) => (
                      <li>
                        <a href={docsHref(i.href)} aria-current={docsHref(i.href) === here ? 'page' : undefined}>
                          {i.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )
    }

    {
      !docs && (
        <div class="rail__meta">
          <span class="rail__meta-line">
            <span>One Rust binary · Postgres</span>
          </span>
        </div>
      )
    }

    {
      sections && (
        <nav class="rail__toc" aria-label="On this page" data-spy="true">
          {sections.map((s, i) => (
            <a href={`#${s.id}`}>
              <span class="rail__num">{String(i + 1).padStart(2, '0')}</span>
              <span>{s.title}</span>
            </a>
          ))}
        </nav>
      )
    }

    <div class="rail__foot">
      {
        docs && (
          <div class="rail__meta" style="margin-top:0;padding-top:0;border-top:0">
            <span class="rail__meta-line">
              <span>One Rust binary · Postgres</span>
            </span>
          </div>
        )
      }
      {
        !docs && (
          <div>
            <div class="rail__foot-title">One model, every caller.</div>
            <div class="rail__foot-sub">apps, people, and agents</div>
          </div>
        )
      }
      <button type="button" class="theme-toggle" data-theme-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        Light / dark
      </button>
    </div>
  </div>
</aside>
