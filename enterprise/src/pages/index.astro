---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import { BASE, docsHref } from '../lib/nav';

const sections = [
  { id: 'changes', title: 'Changes safely' },
  { id: 'web-app', title: 'Web app' },
  { id: 'use-cases', title: 'Use cases' },
  { id: 'workflow', title: 'One incident' },
  { id: 'one-model', title: 'One model' },
  { id: 'organizations', title: 'Organizations' },
  { id: 'ontology', title: 'Ontology' },
  { id: 'actions', title: 'Actions' },
  { id: 'agents', title: 'Agents' },
  { id: 'isolation', title: 'Isolation' },
  { id: 'what-it-isnt', title: "What it isn't" },
  { id: 'run-it', title: 'Run it' },
];

const files = [
  {
    name: 'object-type.json',
    glyph: '{}',
    lang: 'json',
    note: 'POST /v1/ontology/object-types',
    code: `{
  "api_name": "employee",
  "display_name": "Employee",
  "properties": [
    { "api_name": "name", "type": { "kind": "string" }, "required": true,
      "rules": [{ "rule": "length", "min": 1, "max": 100 }] },
    { "api_name": "email", "type": { "kind": "string" },
      "rules": [{ "rule": "email" }, { "rule": "unique" }] },
    { "api_name": "manager", "type": { "kind": "user_ref" } },
    { "api_name": "started", "type": { "kind": "date" } },
    { "api_name": "office", "type": { "kind": "geo_point" } },
    { "api_name": "badge", "type": { "kind": "string" },
      "rules": [{ "rule": "validator", "name": "luhn", "version": 2 }] }
  ]
}`,
  },
  {
    name: 'query.json',
    glyph: '{}',
    lang: 'json',
    note: 'POST /v1/ontology/objects/employee/query',
    code: `{
  "filter": { "op": "and", "filters": [
    { "op": "linked", "link": "projects", "object": "o9k3m7p1s5v2x6z0b4d8f2h6" },
    { "op": "gte", "property": "started", "value": "2026-01-01" },
    { "op": "not", "filter": { "op": "is_null", "property": "email" } }
  ] },
  "order_by": { "property": "started", "direction": "desc" },
  "limit": 50
}`,
  },
  {
    name: 'luhn.py',
    glyph: 'py',
    lang: 'python',
    note: 'POST /v1/ontology/validators',
    code: `def validate(value):
    digits = [int(c) for c in value if c.isdigit()]
    if len(digits) != len(value) or len(digits) < 8:
        return "badge numbers are at least 8 digits"
    total = 0
    for i, d in enumerate(reversed(digits)):
        if i % 2 == 1:
            d = d * 2 - 9 if d > 4 else d * 2
        total += d
    return total % 10 == 0`,
  },
  {
    name: 'events',
    glyph: '~',
    lang: 'text',
    note: 'GET /v1/ontology/events',
    code: `id: 1042
event: object.created
data: {"type":"employee","id":"o4b8j2e6c0t1q5w9r3y7u2i6","version":1,"properties":{"name":"Ada"}}

id: 1043
event: link.created
data: {"link":"projects","from_type":"employee","from":"o4b8j2e6c0t1q5w9r3y7u2i6","to_type":"project","to":"o9k3m7p1s5v2x6z0b4d8f2h6"}

id: 1044
event: object.updated
data: {"type":"employee","id":"o4b8j2e6c0t1q5w9r3y7u2i6","version":2,"properties":{"name":"Ada","started":"2026-03-01"}}`,
  },
];


// The worked examples, one tile each.
const cases: { title: string; href: string; what: string; uses: string }[] = [
  {
    title: 'Machine maintenance',
    href: 'examples/maintenance/',
    what: 'Incidents, assignments, and work orders. Technicians see only the incidents assigned to them, and a high-severity close needs a second person.',
    uses: 'assigned access · actions · four-eyes approval · webhooks',
  },
  {
    title: 'Document management',
    href: 'examples/documents/',
    what: 'Folders and versioned documents shared with people and teams. Files are readable by whoever sees the document, and unsharing ends that at once.',
    uses: 'sharing lists · team access · attachments · version conflicts',
  },
  {
    title: 'Car sales',
    href: 'examples/car-sales/',
    what: 'Stock, leads, reservations, deals, and invoices. Salespeople see their own customers, a large discount needs a manager, and closing sells the car and emails a numbered invoice at once.',
    uses: 'custom formats · one-to-one links · sequences · emails to customers',
  },
  {
    title: 'An agentic dev team',
    href: 'examples/dev-team/',
    what: 'Issues, tasks, pull requests, and reviews for people and coding agents. Agents claim work and spend their own budgets; CI reports back through signed webhooks.',
    uses: 'races · private budgets · review policy · webhooks in and out',
  },
  {
    title: 'Smart home and household',
    href: 'examples/home/',
    what: 'Devices, scenes, chores, and a maintenance calendar. A hub agent carries out changes, schedules add the recurring work, and a guest’s access ends with the stay.',
    uses: 'scheduled actions · expiring memberships · automations · calendars',
  },
  {
    title: 'Your own',
    href: 'concepts/ontology/',
    what: 'Define your own types, rules, and actions in the web app or through the API, start small, and change them as the business changes.',
    uses: 'web app · API · versioned changes',
  },
];

// The maintenance example, step by step: who, what, and what came back.
const steps: { who: string; what: string; outcome: string; refused?: boolean }[] = [
  { who: 'dispatch-bot · REST', what: 'An agent account reports a hydraulic leak on Press 7 and links it to the machine.', outcome: '201 incident' },
  { who: 'dispatch-bot · REST', what: 'It applies assign_incident: an assignment is recorded and Tess is emailed.', outcome: '201 applied' },
  { who: 'dispatch-bot · REST', what: 'Its answer is lost, so it retries with the same idempotency key.', outcome: '200 replayed' },
  { who: 'Tess · MCP', what: 'Her assistant sees only the incidents assigned to her, and lists the actions she may apply.', outcome: '1 incident visible' },
  { who: 'Tess · MCP', what: 'It tries to reassign the incident. Technicians are not granted that action.', outcome: '403 forbidden', refused: true },
  { who: 'Tess · MCP', what: 'It opens a work order: the order, two links, the incident in progress, the machine in maintenance, in one transaction.', outcome: '201 applied' },
  { who: 'Tess · MCP', what: 'It submits the close with the version it read before the work order changed the incident.', outcome: '409 version_conflict', refused: true },
  { who: 'Tess · MCP', what: 'It reads the incident again and submits the close for approval.', outcome: '201 awaiting approval' },
  { who: 'Tess · MCP', what: 'It tries to approve her own close of a high-severity incident.', outcome: '422 criteria_failed', refused: true },
  { who: 'Sam · REST', what: 'The supervisor, who watched every change on the event stream, approves. The incident is closed.', outcome: '201 closed' },
];
---

<Base title="Happy Enterprise: there are many AI systems; this one is yours">
  <div class="frame">
    <Rail current="home" sections={sections} />
    <div class="page-body">
      <main class="landing" id="content">
        <section class="hero">
          <h1 class="hero__title">
            There are many AI systems. This one is yours. <a class="soft" href="#one-model">Your data, your rules, your server.</a>
          </h1>
          <p class="hero__lead">
            Happy Enterprise is the engine your people, apps, and agents share: your records, the rules they follow, and
            who may see and change each one, down to a single record, with the same checks for everyone. It runs on your
            own server, starts with one list, and changes safely as your business does. People use the web app that
            comes with it; your own apps and agents use the same API.
          </p>
          <div class="hero__actions">
            <a class="btn-primary" href={docsHref('')}>Read the docs</a>
            <a class="btn-secondary" href={docsHref('how-it-fits/')}>How it fits</a>
          </div>
          <p class="hero__fine">
            One Rust binary on Postgres, with a web app. Running in ten minutes? <a href={docsHref('quickstart/')}>Quickstart</a>{' · '}
            <a href={docsHref('api/')}>API reference</a>
          </p>
        </section>

        <section class="section" id="changes">
          <h2>Changes as your business changes.</h2>
          <p>
            Businesses take on new kinds of records, tighten rules, add steps to a process, and bring in people and
            agents. Each of those is a change to the model, and the system takes it on while it runs: no migration, no
            downtime, and nothing already stored put at risk.
          </p>
          <ul class="tiles tiles--3">
            <li>
              <span class="tile__k">New records and fields</span>
              <span class="tile__d">Add a type or a property and use it at once. Removing one is instant, and its old values never come back.</span>
            </li>
            <li>
              <span class="tile__k">New rules</span>
              <span class="tile__d">They apply to writes at once and to stored objects in the background. Invalid objects stay visible, marked, until fixed.</span>
            </li>
            <li>
              <span class="tile__k">Every version kept</span>
              <span class="tile__d">Object types and actions keep every version, and each action application records the one it ran.</span>
            </li>
            <li>
              <span class="tile__k">New steps</span>
              <span class="tile__d">Define a new action, validator, or format while the system runs, and grant it to the teams that need it.</span>
            </li>
            <li>
              <span class="tile__k">Access still holds</span>
              <span class="tile__d">Permissions, restricted types, and isolation between organizations apply to every change, as to every read.</span>
            </li>
            <li>
              <span class="tile__k">Agents within their grants</span>
              <span class="tile__d">An agent changes the model only with <code>manage_ontology</code>; an assistant over MCP never does.</span>
            </li>
          </ul>
          <p style="margin-top:1.25rem">
            <a href={docsHref('concepts/ontology/#versions-and-schema-changes')}>Versions and schema changes</a>{' · '}
            <a href={docsHref('concepts/actions/#versions')}>Action versions</a>
          </p>
        </section>

        <section class="section" id="web-app">
          <h2>Comes with a web app.</h2>
          <p>
            Browse and edit objects in tables and calendars, change the model, apply actions from generated forms,
            follow the audit log and the live feed, and manage people, teams, and security. The web app uses the same API
            as your agents and your own apps, so it shows each person exactly what they may see, and nothing more.
          </p>
          <figure class="shot wide">
            <img class="shot--light" src={`${BASE}shots/objects-table.webp`} width="1600" height="1000" loading="lazy" alt="The web app's object table: incidents with their severity, status, assignee, and validation state" />
            <img class="shot--dark" src={`${BASE}shots/objects-table-dark.webp`} width="1600" height="1000" loading="lazy" alt="" />
          </figure>
          <p style="margin-top:1.25rem">
            <a href={docsHref('web-app/')}>The web app</a>{' · '}
            <a href={docsHref('quickstart/#8-open-the-web-app')}>Run it</a>
          </p>
        </section>

        <section class="section" id="use-cases">
          <h2>One engine for the apps you would otherwise build.</h2>
          <p>
            Maintenance tracking, document management, a dealership's sales, a team's issue tracker, and a household's
            devices and chores are usually separate apps, each with its own database, permission checks, and audit trail. Here each is a model and a set of actions loaded into the same engine, used
            by the same people and agents under the same rules.
          </p>
          <ul class="tiles tiles--3 cases">
            {
              cases.map((c) => (
                <li>
                  <a class="tile__k" href={docsHref(c.href)}>{c.title}</a>
                  <span class="tile__d">{c.what}</span>
                  <span class="cases__uses">{c.uses}</span>
                </li>
              ))
            }
          </ul>
          <p style="margin-top:1.25rem">
            <a href={docsHref('examples/')}>All use cases</a>{' · '}
            <a href="#workflow">One of them, step by step</a>
          </p>
        </section>

        <section class="section" id="workflow">
          <h2>One incident, an agent, an assistant, and a person.</h2>
          <p>
            A machine breaks down. An agent account reports and assigns the incident, a technician's assistant does the
            work through MCP, and a supervisor approves it in an app. Each step is an action the organization defined,
            checked against who is calling and what the data looks like when it commits. Everyone sees the same objects.
          </p>
          <ul class="steps wide">
            {
              steps.map((s) => (
                <li data-refused={s.refused ? '' : undefined}>
                  <span class="steps__who">{s.who}</span>
                  <span>{s.what}</span>
                  <code>{s.outcome}</code>
                </li>
              ))
            }
          </ul>
          <p style="margin-top:1.25rem">
            <a href={docsHref('examples/maintenance/')}>Walk through the example</a>{' · '}
            <a href={docsHref('concepts/actions/')}>Business actions</a>
          </p>
        </section>

        <section class="section" id="one-model">
          <h2>One model for apps, people, and agents.</h2>
          <p>
            A dashboard, a person working through an assistant, and a background agent all refer to the same incident.
            They meet the same validation, the same permissions, and see each other's changes on the same event stream.
          </p>
          <ul class="tiles tiles--3">
            <li>
              <span class="tile__k">Your apps</span>
              <span class="tile__d">The REST API, signed in as a person with an emailed code or your identity provider.</span>
            </li>
            <li>
              <span class="tile__k">Assistants</span>
              <span class="tile__d">Any MCP client, acting for the person who signed in, within what they consented to.</span>
            </li>
            <li>
              <span class="tile__k">Agent accounts</span>
              <span class="tile__d">Your own processes, with API tokens and only the permissions their team grants.</span>
            </li>
          </ul>
          <p style="margin-top:1.25rem">
            <a href={docsHref('how-it-fits/')}>How it fits</a>{' · '}
            <a href={docsHref('#current-limits')}>Current limits</a>
          </p>
        </section>

        <section class="section" id="organizations">
          <h2>People, agents, teams.</h2>
          <p>
            Each organization has human users who sign in with an emailed code, and agents that use API tokens.
            Teams grant permissions; <code>owners</code> and <code>everyone</code> always exist, and the database
            itself keeps at least one owner. Organizations can require two-factor authentication, admit whole verified
            domains, or bring their own identity provider.
          </p>
          <ul class="tiles tiles--4">
            <li>
              <span class="tile__k">Email codes</span>
              <span class="tile__d">Six digits, ten minutes, five tries.</span>
            </li>
            <li>
              <span class="tile__k">Two factors</span>
              <span class="tile__d">TOTP apps, security keys, and passkeys.</span>
            </li>
            <li>
              <span class="tile__k">Your IdP</span>
              <span class="tile__d">Ed25519 JWTs, keys registered per organization.</span>
            </li>
            <li>
              <span class="tile__k">Agent tokens</span>
              <span class="tile__d"><span class="tile__mono">heat_…</span>, hashed at rest.</span>
            </li>
          </ul>
          <p style="margin-top:1.25rem">
            <a href={docsHref('concepts/organizations/')}>Users, teams, permissions</a>{' · '}
            <a href={docsHref('concepts/authentication/')}>Authentication</a>
          </p>
        </section>

        <section class="section" id="ontology">
          <h2>An ontology, not a key-value store.</h2>
          <p>
            Object types have typed properties and format rules: strings, numbers, dates, geo points, references to
            users and files, arrays and structs. Links connect objects with a declared cardinality. Every write is
            checked against the type, new rules are applied to stored data in the background with every object marked
            valid, invalid, or pending, deletions are instant, and every change lands in an outbox you can stream.
          </p>
          <div class="viewer wide" data-viewer>
            <div class="viewer__files">
              <div class="viewer__head">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>
                acme / ontology
              </div>
              <ul>
                {
                  files.map((f, i) => (
                    <li>
                      <button type="button" data-open-file={f.name} data-note={f.note} aria-pressed={String(i === 0)}>
                        <span class="viewer__glyph">{f.glyph}</span>
                        <span class="viewer__name">{f.name}</span>
                      </button>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="viewer__pane">
              <div class="viewer__tabs">
                <span data-viewer-name>{files[0].name}</span>
                <small data-viewer-note>{files[0].note}</small>
              </div>
              {
                files.map((f, i) => (
                  <div class="viewer__file" data-file={f.name} hidden={i !== 0}>
                    <Code code={f.code} lang={f.lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
                  </div>
                ))
              }
            </div>
          </div>
          <p style="margin-top:1.25rem">
            Rules too specific for a schema run as Python, in <a href="https://github.com/pydantic/monty">Monty</a>: a
            sandboxed interpreter with no filesystem, network, or imports, 250 ms and 32 MiB per call.
          </p>
          <p style="margin-top:1rem">
            <a href={docsHref('concepts/ontology/')}>The ontology</a>{' · '}
            <a href={docsHref('concepts/validators/')}>Custom validators</a>
          </p>
        </section>

        <section class="section" id="actions">
          <h2>Business actions, all or nothing.</h2>
          <p>
            Objects describe what exists; actions describe what someone may make happen. An organization defines its own
            operations, such as "open a work order for this incident", once. Your app, a person's assistant, and an agent
            account all apply the same action under the same rules, and every application is recorded.
          </p>
          <ul class="tiles tiles--3">
            <li>
              <span class="tile__k">Typed inputs</span>
              <span class="tile__d">Parameters checked like properties, or references to live objects.</span>
            </li>
            <li>
              <span class="tile__k">Who may apply</span>
              <span class="tile__d">Owners grant teams each action, without handing out edit rights.</span>
            </li>
            <li>
              <span class="tile__k">Criteria</span>
              <span class="tile__d">Conditions or Python, checked on exactly what commits.</span>
            </li>
            <li>
              <span class="tile__k">All or nothing</span>
              <span class="tile__d">Every create, update, and link in one transaction.</span>
            </li>
            <li>
              <span class="tile__k">Safe retries</span>
              <span class="tile__d">An idempotency key returns the first result instead of applying twice.</span>
            </li>
            <li>
              <span class="tile__k">Effects after commit</span>
              <span class="tile__d">Signed webhooks and emails, delivered with retries, in the audit log.</span>
            </li>
          </ul>
          <p style="margin-top:1.25rem">
            <a href={docsHref('concepts/actions/')}>Business actions</a>{' · '}<a href={docsHref('api/actions/')}>Actions API</a>
          </p>
        </section>

        <section class="section" id="agents">
          <h2>Two ways for agents to connect.</h2>
          <p>
            An <strong>assistant</strong> acts for a person. Every organization has its own MCP server and OAuth 2.1
            authorization server, so any MCP client can connect with PKCE and dynamic registration. Its tools act for the
            signed-in user and never exceed their permissions or the scopes they granted, and no scope reaches owner
            actions or the schema.
          </p>
          <p style="margin-top:1rem">
            An <strong>agent account</strong> acts as itself: an agent user with API tokens, on the REST API, holding
            what its teams grant. Use it for unattended work such as imports and triage.
          </p>
          <ul class="tiles tiles--3">
            <li><span class="tile__mono">whoami</span><span class="tile__d">who the grant acts for</span></li>
            <li><span class="tile__mono">list_members</span><span class="tile__d">mcp:read + view_members</span></li>
            <li><span class="tile__mono">describe_schema</span><span class="tile__d">the types you may view</span></li>
            <li><span class="tile__mono">query_objects</span><span class="tile__d">filters, ordering, cursors</span></li>
            <li><span class="tile__mono">update_object</span><span class="tile__d">ontology:write + edit_objects</span></li>
            <li><span class="tile__mono">action_open_work_order</span><span class="tile__d">actions:apply + the action's grant</span></li>
          </ul>
          <p style="margin-top:1.25rem">
            <a href={docsHref('how-it-fits/#how-it-connects')}>Which one to use</a>{' · '}
            <a href={docsHref('concepts/mcp/')}>MCP and OAuth</a>{' · '}<a href={docsHref('api/mcp/')}>Tool reference</a>
          </p>
        </section>

        <section class="section" id="isolation">
          <h2>Every organization kept apart.</h2>
          <p>
            Organizations never see or affect each other's data. Every request gets a transaction scoped to exactly
            one organization, Postgres row-level security filters every row underneath it, and the runtime roles cannot
            bypass it. A query that forgets to filter by organization still sees only its own organization's rows.
          </p>
          <ul class="tiles tiles--3">
            <li>
              <span class="tile__k">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                Scoped transactions
              </span>
              <span class="tile__d">Handlers only ever get a transaction scoped to one organization, built from a verified credential. No pool, no way around it.</span>
            </li>
            <li>
              <span class="tile__k">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" /><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" /></svg>
                Postgres
              </span>
              <span class="tile__d">Forced RLS on every table, the organization set per transaction, and roles that are <code>NOBYPASSRLS</code>, checked at startup.</span>
            </li>
            <li>
              <span class="tile__k">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4" /><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z" /></svg>
                Tests
              </span>
              <span class="tile__d">Tests write to every organization table and try to cross over; a table without the policy fails them.</span>
            </li>
          </ul>
          <p style="margin-top:1.25rem">
            Isolation and authorization rules are enforced by PostgreSQL row-level security and covered by
            machine-checked models and integration tests.
          </p>
          <p style="margin-top:1rem">
            <a href={docsHref('concepts/isolation/')}>How organizations are kept apart</a>
          </p>
        </section>

        <section class="section" id="what-it-isnt">
          <h2>What it is, and isn't.</h2>
          <dl class="qa wide">
            <div>
              <dt>An app and an API.</dt>
              <dd>People use the web app that comes with it. Build your own apps on the same REST API, or let agents use the MCP server.</dd>
            </div>
            <div>
              <dt>For smaller teams.</dt>
              <dd>One binary and one Postgres. No Kafka, no Redis, no cluster to babysit.</dd>
            </div>
            <div>
              <dt>Not a data warehouse.</dt>
              <dd>Objects are JSON documents checked against their types, queried with typed filters. Bring your analytics elsewhere.</dd>
            </div>
            <div>
              <dt>Not a sandbox for agent-written code.</dt>
              <dd>Isolation keeps a buggy handler inside its organization. Server code an agent writes needs review like any other.</dd>
            </div>
            <div>
              <dt>Not finished.</dt>
              <dd>Access goes down to the objects shared with each member, not to single properties or along links, and filters on properties are not indexed yet. See <a href={docsHref('#current-limits')}>current limits</a> and <a href={docsHref('self-hosting/performance/')}>measured performance</a>.</dd>
            </div>
          </dl>
        </section>

        <section class="section" id="run-it">
